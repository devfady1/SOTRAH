# Sotrah SaaS Backend Environment Variables
DJANGO_SECRET_KEY=your-production-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,sotrah.com

# Database (Leave empty for SQLite in local dev, or provide PostgreSQL URL)
# DATABASE_URL=postgres://user:password@localhost:5432/sotrah_db

# Google Tag Manager (GTM)
GTM_ID=GTM-XXXXXXX
